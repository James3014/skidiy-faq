# FAQ insights access
# Comma-separated API keys that are allowed to call /api/v1/analytics/faq-insights
FAQ_INSIGHTS_API_KEYS=replace-with-secure-key

# Admin authentication
ADMIN_JWT_SECRET=replace-this-secret
#ADMIN_JWT_AUDIENCE=optional-aud
#ADMIN_JWT_ISSUER=optional-issuer
